# Formspree endpoint used by /api/contact to forward contact form
# submissions to your email. Get this from https://formspree.io
# after creating a form — it looks like https://formspree.io/f/xxxxxxxx
FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# --- Admin Dashboard Authentication ---
# Email used to log in to /admin/login. Not a real account lookup —
# just the single administrator identity for this system.
ADMIN_EMAIL=your-admin-email@example.com

# bcrypt hash of the admin password. NEVER put a plaintext password here.
# Generate one with:
#   node -e "const b=require('bcryptjs');console.log(b.hashSync('your-password',12))"
#
# IMPORTANT: bcrypt hashes always contain "$" characters (e.g. $2b$12$...).
# Next.js expands "$"-prefixed sequences in .env files (dotenv-expand)
# treating them as variable references, which silently corrupts the
# hash. Escape every "$" as "\$" in this file, e.g.:
#   ADMIN_PASSWORD_HASH=\$2b\$12\$abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUV
ADMIN_PASSWORD_HASH=your-bcrypt-password-hash-with-escaped-dollar-signs

# Random secret (32+ characters) used to sign admin session JWTs.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your-random-session-secret-at-least-32-chars
